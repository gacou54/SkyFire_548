# Copy to .env and adjust. Every value here is optional.

# Client data (dbc/maps/vmaps/mmaps). Extracted into this folder by the extractor.
SKYFIRE_DATA_DIR=./docker/data
# 5.4.8 client folder (contains Data/), only needed by the extractor.
WOW_CLIENT_DIR=/path/to/World of Warcraft

# Address the game client connects to. Use the host's LAN/public IP when the
# client is on another machine.
REALM_ADDRESS=127.0.0.1
REALM_NAME=SkyFire MoP

AUTH_PORT=3724
WORLD_PORT=8085

DB_USER=skyfire
DB_PASSWORD=skyfire
DB_ROOT_PASSWORD=skyfire-root
# MySQL is published on the host only on this interface.
DB_BIND=127.0.0.1
DB_PORT=3306
DB_BUFFER_POOL_SIZE=1G

# Import sql/pending_updates on startup (development only).
IMPORT_PENDING_UPDATES=0

# Remote admin; published on 127.0.0.1 only.
RA_ENABLE=0
SOAP_ENABLE=0

# Build settings.
SKYFIRE_BUILD_TYPE=Release
SKYFIRE_BUILD_JOBS=
# Container user; match your host uid/gid so it can write SKYFIRE_DATA_DIR.
SKYFIRE_UID=1000
SKYFIRE_GID=1000
